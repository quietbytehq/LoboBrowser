ac_add_options --with-app-name=${binName}
export MOZ_USER_DIR="${name}"
export MOZ_APP_BASENAME=${binName}
export MOZ_DISTRIBUTION_ID=${appId}

# Uncomment if builds are too resource hungry
# Limited to 4 jobs so the build fits in about 14 GB of RAM
mk_add_options MOZ_MAKE_FLAGS="-j4"
# ac_add_options --enable-linker=gold

# Misc
export MOZ_STUB_INSTALLER=1
# Off for local builds: the source changeset changes with every commit and would
# force a near-full rebuild each time. Turn back on for release builds.
# export MOZ_INCLUDE_SOURCE_INFO=1
# Change the below repository to your GitHub repository.
# Also off for local builds (source-repo.h needs a changeset when this is set).
# export MOZ_SOURCE_REPO=https://github.com/quietbytehq/LoboBrowser
# export MOZ_SOURCE_CHANGESET=${changeset}

# Bootstrap
ac_add_options --enable-bootstrap
